# EditorConfig for Neuro-Pipeline
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h,cc,c}]
indent_style = space
indent_size = 2

[*.{py}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{proto}]
indent_style = space
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[CMakeLists.txt,*.cmake]
indent_style = space
indent_size = 2

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_style = space
indent_size = 2

[Dockerfile]
indent_style = space
indent_size = 2
