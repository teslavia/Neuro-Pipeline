# Docker build context exclusions for cross-compile environment
# Keeps the build context small and fast

# Build artifacts (exclude repo build dirs, NOT sysroot)
**/build/
**/cmake-build-*/
**/*.o
**/*.dylib

# Python caches
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/*.egg-info/
**/venv/
**/.venv/

# Model files (large binaries)
**/*.onnx
**/*.pt
**/*.pth
**/*.bin
**/*.safetensors
**/*.mlx
**/*.rknn

# IDE & OS
**/.vscode/
**/.idea/
**/.DS_Store
**/*.swp

# Git
**/.git/

# Third-party submodules (Docker only needs sysroot/, not full submodules)
**/third_party/

# Logs
**/*.log

# Docs & notes
**/*.md
**/docs/
